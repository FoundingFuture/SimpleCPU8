10 GOTO 1000
20 H=DEEK(C):I=DEEK(C+2):N=PEEK(C+4):D=PEEK(C+5)-1:A=S+H/2:Q=N>1
30 IF D<0 THEN 70
40 IF H MOD 2 THEN 60
50 X=PEEK(A+1):IF X<144 THEN POKE A,130+Q*16,X+32:H=H+1:GOTO 110
55 GOTO 300
60 X=PEEK(A+1):IF X=160 THEN POKE A,PEEK(A)-2+Q,168:H=H+1:GOTO 110
65 GOTO 300
70 IF H MOD 2 THEN 90
80 X=PEEK(A-1):IF X MOD 16=0 THEN POKE A-1,X+3,176+Q:H=H-1:GOTO 110
85 GOTO 300
90 X=PEEK(A):IF X=131 THEN POKE A,184,PEEK(A+1)-48+Q*16:H=H-1:GOTO 110
95 GOTO 300
110 I=I+1:DOKE R+I MOD 64*2,H:DOKE C,H:DOKE C+2,I:IF N<2 THEN RETURN
120 T=DEEK(R+(I-N*2+1) MOD 64*2):U=DEEK(R+(I-N*2+2) MOD 64*2)-T:IF U=-1 THEN T=T+1
130 IF U*U=1 THEN A=S+T/2:IF T MOD 2 THEN POKE A,PEEK(A)-1:RETURN
140 IF U*U=1 THEN POKE A,PEEK(A)-16:RETURN
150 A=S+T/2:IF T MOD 2 THEN POKE A,PEEK(A)-1,PEEK(A+1)-16:RETURN
160 POKE A,PEEK(A)-17:RETURN
300 POKE $E7FE,PEEK($E7FE)+1:A=A+32:H=H+64:POKE C+5,2-PEEK(C+5):GOTO 110
1000 SETTEXT 8,8:S=$F000:R=$E100:C=$E000
1010 FOR I=0 TO 31:POKE S+64+I,128:POKE S+96+I,128:NEXT
1020 H=128+24:I=1000
1030 FOR K=0 TO 23:DOKE R+(I-23+K) MOD 64*2,H-23+K:NEXT
1040 FOR K=0 TO 11:POKE S+64+K,145:NEXT:POKE S+76,168
1050 DOKE C,H:DOKE C+2,I:POKE C+4,12:POKE C+5,2
1060 FOR K=0 TO 7
1070 POKE $E7FF,K+1
1080 GOSUB 20
1090 NEXT
